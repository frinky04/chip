<?xml version="1.0" encoding="utf-8"?>
<!-- Single-file, self-contained Windows build: Chip.exe plus the loose assets/ folder. No .NET install needed.
     Usage: dotnet publish src/Chip.Editor -p:PublishProfile=win-x64   (or scripts/publish.ps1) -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- GLFW, cimgui and nfd are native DLLs; bundle them too (extracted to a per-version temp folder on first run). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
