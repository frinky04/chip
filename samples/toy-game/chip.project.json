{
  "version": 1,
  "engine": "Toy",
  "entities": "chip/entities.json",
  "assetPrefix": "assets/",
  "surfaces": {
    "video": {
      "doc": "Shows the video of the screen it belongs to",
      "look": { "image": "chip/surfaces/video.png" }
    },
    "monster_clip": {
      "render": false,
      "collide": "always",
      "doc": "Blocks monsters, lets players through",
      "look": { "color": "#d0406a" }
    }
  },
  "kinds": {
    "sound": {
      "root": "assets/sounds",
      "ext": [
        ".wav"
      ],
      "store": "stem"
    }
  },
  "flags": {
    "power_on": {
      "type": "bool",
      "default": false,
      "scope": "game"
    },
    "generators_fixed": {
      "type": "int",
      "default": 0,
      "scope": "level"
    }
  }
}
